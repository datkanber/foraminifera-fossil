    "global_response_states": {
      "PRESENT": {
        "tr": "Var",
        "note": "The character is clearly observable in the specimen."
      },
      "ABSENT": {
        "tr": "Yok",
        "note": "Expected to be observable in the available section but clearly absent."
      },
      "NOT_OBSERVABLE": {
        "tr": "Gözlenemiyor",
        "note": "Cannot be reliably evaluated (section orientation, preservation, image quality, incomplete exposure). NOT_OBSERVABLE != ABSENT; must not exclude a genus."
      },
      "UNCERTAIN": {
        "tr": "Emin değilim",
        "note": "Observed area visible but state cannot be confidently determined. Neutral score."
      }
    },
    "core_rule": "Specimen -> Character ID -> Observed Value -> Observation State",
    "principle": "ONE MORPHOLOGICAL CHARACTER = ONE CHARACTER ID"
  },
