NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Gemini Vision Observer
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# WoRMS Taxonomy Service
WORMS_BASE_URL=https://www.marinespecies.org/rest
WORMS_TIMEOUT=3000
WORMS_CACHE_DAYS=7

# Independent expert validation (same-origin client /api proxy required)
VALIDATION_APP_ORIGIN=http://localhost:3000
# Optional separate Neo4j database; leave blank to use the existing database.
VALIDATION_NEO4J_DATABASE=
# Full source commit; required on deployments without a .git directory.
VALIDATION_GIT_COMMIT=
# Set to the exact number of trusted reverse proxy hops for your host.
VALIDATION_TRUST_PROXY_HOPS=0
# Optional one-time coordinator bootstrap. Remove both after the first successful deploy.
VALIDATION_BOOTSTRAP_LOGIN=
VALIDATION_BOOTSTRAP_PASSWORD=
